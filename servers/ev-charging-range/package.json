{
  "name": "@cbaileydev/ev-charging-range-mcp",
  "version": "0.1.0",
  "description": "EV charging-station lookup (NREL AFDC + Open Charge Map) and conservative range-margin planning MCP server.",
  "type": "module",
  "bin": {
    "ev-charging-range-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "smoke": "SMOKE=1 AFDC_API_KEY=DEMO_KEY vitest run src/smoke.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
