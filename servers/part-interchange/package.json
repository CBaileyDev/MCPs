{
  "name": "@cbaileydev/part-interchange-mcp",
  "version": "0.1.0",
  "description": "MCP server scaffold for cross-referencing OEM and aftermarket part numbers. Requires a data provider (not wired by default).",
  "type": "module",
  "bin": {
    "part-interchange-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
